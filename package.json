{
  "name": "g7petsgrooming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm --prefix apps/admin-ui run dev",
    "dev:public": "npm --prefix apps/public-ui run dev",
    "dev:api": "npm --prefix apps/worker-api run dev",
    "build:admin": "npm --prefix apps/admin-ui run build",
    "build:public": "npm --prefix apps/public-ui run build",
    "build:api": "npm --prefix apps/worker-api run build",
    "build": "npm run build:api && npm run build:admin && npm run build:public"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "typescript": "^5.9.2"
  }
}
